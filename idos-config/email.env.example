# Email SMTP Configuration (Gmail)
# 1. Enable 2FA in your Google Account
# 2. Generate App Password at https://myaccount.google.com/apppasswords
# 3. Copy the 16-char password below

IDOS_SMTP_HOST=smtp.gmail.com
IDOS_SMTP_PORT=587
IDOS_SMTP_USER=your.email@gmail.com
IDOS_SMTP_PASS=your-16-char-app-password
IDOS_FROM_ADDR=your.email@gmail.com
IDOS_TO_ADDR=recipient@example.com
